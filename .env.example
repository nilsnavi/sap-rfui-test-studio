# SAP RFUI Test Studio — environment template
# Copy to `.env` for local development. `.env` and `.env.*` are git-ignored.
# NEVER put real SAP passwords, tokens, cookies or production secrets here.
# Credentials are provided interactively at runtime and are never persisted by the application.

# --- Build / runtime ---
# Vite dev server host used by the Tauri shell.
VITE_DEV_SERVER_URL=http://localhost:5173
# Explicit application version override for the UI (falls back to 0.1.0 from package manifests).
VITE_APP_VERSION=0.1.0
# Telemetry verbosity: debug | info | warn | error
VITE_LOG_LEVEL=info

# --- SAP connection placeholders (not used yet: Sprint M2) ---
# Only non-secret values may live here.
SAP_ENVIRONMENT_ID=
SAP_BASE_URL=
SAP_CLIENT=
SAP_RFUI_SERVICE=
